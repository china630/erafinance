# Copy to .env in repo root for Prisma CLI / local tooling
#
# Инфраструктура на диске D (не C:):
#   D:\DockerData\erafinance_erp\ — postgres, redis, storage, npm-cache, tmp (шаблон README: docker/README-docker-data.txt)
#   Корневой .npmrc задаёт npm cache на D; .vscode/settings.json — TEMP/TMP для терминала.
#   Docker Desktop: перенесите Disk image location на D, иначе образы останутся на C.

# Каталог данных Docker и локальных загрузок
DOCKER_DATA_ROOT=D:/DockerData/erafinance_erp

DATABASE_URL="postgresql://erafinance:erafinance@127.0.0.1:5432/erafinance?schema=public"

# JWT (обязательно для API; без них Nest не стартует)
JWT_SECRET=dev-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-me
# WA0001 (PII at-rest): dedicated keys for field encryption / blind index.
# Prod: set strong random values (base64/hex/plain); local fallback uses JWT_SECRET.
PII_ENCRYPTION_KEY=
PII_BLIND_INDEX_KEY=
# Auth/join VÖEN lookup works via blind index only.
PII_STRICT_BLIND_LOOKUP=1
# Access JWT (веб-клиент); по умолчанию в коде API — 12h, если переменная не задана
JWT_ACCESS_EXPIRES=12h
JWT_REFRESH_EXPIRES=7d

# Audit log hash chain HMAC (prod: set explicitly; otherwise API falls back to JWT_SECRET with a startup warning)
# AUDIT_HASH_SECRET=

# Super-admin email step-up HMAC (`step-up-auth.service.ts`; dev fallback JWT_SECRET)
# STEP_UP_HMAC_SECRET=

# Webhook URL for CRITICAL audit chain alerts (`audit-chain-cron.service.ts`)
# AUDIT_ALERT_WEBHOOK_URL=
# `npm run audit:verify` — set to 1 on staging/prod DB copies to fail CI if chain is broken
# AUDIT_VERIFY_STRICT=1

# Browser extension (ERA Finance Assistant): isolated refresh cookie refresh_token_ext (sameSite=none)
# EXT_REFRESH_SECRET=  # optional; defaults to JWT_SECRET if unset
EXT_REFRESH_EXPIRES=1d
# Production: comma-separated web Origins allowed to bootstrap extension session (POST /api/auth/extension/refresh)
# ERP_WEB_ORIGINS=https://erp.example.com
# Production: chrome-extension://… and moz-extension://… IDs from Web Store / AMO
# CORS_EXTENSION_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
# Local dev extension id (manifest key / unpacked id) for documentation only
# EXT_DEV_ID=dev-extensionId

# Гостевой портал счёта (опционально): отдельный секрет для HMAC токена ссылки; иначе используется JWT_SECRET
# INVOICE_PORTAL_TOKEN_SECRET=
# Канонический origin ссылок «Поделиться» (клиент откроет в WhatsApp и т.д.)
# INVOICE_PORTAL_PUBLIC_ORIGIN=https://erp.example.com

# API (apps/api)
API_PORT=4000
# Liveness API (без JWT): канонический GET {NEXT_PUBLIC_API_URL}/api/health
# Legacy на том же хосте: GET /health — тот же JSON (балансировщики, старые мониторинги)
# Production: через запятую, точные Origin фронта (например https://app.example.com)
# CORS_ORIGINS=https://app.example.com
REDIS_URL="redis://localhost:6379"
# When API runs on the host (`npm run dev` / START-ERP.bat), REDIS_URL must use localhost or 127.0.0.1
# and the published port (6379 from root docker-compose.yml). Do NOT use hostname `redis` — that only
# resolves inside Docker Compose; ioredis will ETIMEDOUT from Windows.
# REDIS_URL="redis://127.0.0.1:6379"
# Опционально: отдельный Redis logical DB для очередей (номер в path), см. apps/api/src/queue/bullmq.config.ts
# REDIS_URL="redis://localhost:6379/2"
# Вебхук при падении BullMQ-задачи (Slack / Telegram и т.п.)
# ERAFINANCE_BULLMQ_ALERT_WEBHOOK_URL=
# Срок жизни метаданных tenant snapshot (дней), по умолчанию 30 — см. snapshot.service.ts
# SNAPSHOT_RETENTION_DAYS=30

# BullMQ: отключить ежемесячные SubscriptionInvoice (по умолчанию включено при REDIS)
# BILLING_MONTHLY_DISABLED=1

# BullMQ: отключить ежемесячное начисление амортизации ОС (1-го числа 01:00 UTC)
# FIXED_ASSETS_MONTHLY_DISABLED=1

# Drakaris / yığım (Basic Auth для входящих GET/POST на /api/integrations/drakaris/v1/...)
# DRAKARIS_ENABLED=0
# DRAKARIS_ENV=test
# DRAKARIS_BASIC_USER=
# DRAKARIS_BASIC_PASS=
# DRAKARIS_TEST_BASE_URL=https://test-api.provider-url.com/v1
# DRAKARIS_LIVE_BASE_URL=https://live-api.provider-url.com/v1

# Web (Next.js): подхватывается при `npm run dev:web` из корня через dotenv-cli
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
# ERP UI CTA for browser extension installation (replace with Chrome Web Store URL in production)
NEXT_PUBLIC_EXTENSION_INSTALL_URL=/docs/extension
# Должен совпадать с INVOICE_PORTAL_PUBLIC_ORIGIN при копировании ссылок с локального фронта (по умолчанию в коде API — erp.example.com)
# NEXT_PUBLIC_PORTAL_PUBLIC_ORIGIN=http://localhost:3000

# SMTP (отправка счетов и др.; без SMTP_HOST письма не уходят — API только логирует «Email would be sent to …»)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ERA Finance <no-reply@example.com>"
# Вложения (логотипы, PDF счетов): по умолчанию S3. Локально без ключей укажите STORAGE_DRIVER=local.
STORAGE_DRIVER=s3
# Совпадает с томом проекта на D; при STORAGE_DRIVER=local — каталог файлов
STORAGE_LOCAL_ROOT=D:/DockerData/erafinance_erp/storage
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Prisma seed (`npm run db:seed:demo`): stub MMC + super-admin attach — **not** TiVi showcase.
# Full TiVi Media/Sport: npm run db:seed:showcase   (or npm run seed:local -w @erafinance/api)
# SEED_DEMO_ORG=1

# VÖEN lookup (TaxService): без этого e-taxes может отдавать HTML — для стабильных E2E задайте 1
# TAX_LOOKUP_MOCK=1

# Sentry (optional; SDK stays off if DSN empty)
# API: https://docs.sentry.io/platforms/javascript/guides/nestjs/
# SENTRY_DSN_API=
# Web client (public, baked into Next bundle at build)
# NEXT_PUBLIC_SENTRY_DSN=
# Web server/edge (optional override; defaults to NEXT_PUBLIC_SENTRY_DSN)
# SENTRY_DSN_WEB=
# Source maps upload during next build / Docker web build (Auth Token from Sentry UI)
# SENTRY_AUTH_TOKEN=
# Sentry org slug and project slug (not numeric project id)
# SENTRY_ORG=
# SENTRY_PROJECT_WEB=
# SENTRY_PROJECT_API=

# OCR (Phase 11)
OCR_VISION_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
OCR_MAX_FILE_MB=10
